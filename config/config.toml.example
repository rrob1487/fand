[daemon]
poll_interval = 5
log_level = "INFO"
# Seconds between IPMI sensor re-scans. The BMC's sensor list is not fixed at
# startup: after an AC power loss the iDRAC repopulates its SDR on its own
# schedule, often slower than the host boots, so a set discovered once can be
# incomplete. Re-scanning picks up sensors that appear later and drops ones that
# vanish. This is not how often sensors are read -- that is poll_interval.
sensor_rediscover_interval = 300

[fan_curve]
# Ordered (temperature_c, fan_percent) points; the policy layer
# interpolates between them.
points = [
    [40, 20],
    [50, 30],
    [60, 40],
    [75, 70],
    [85, 100],
]
# Minimum drop (in fan percent) required before the target is allowed to
# decrease; prevents oscillation. Rising targets are never damped.
hysteresis_percent = 5

[safety]
# Must stay above the fan curve's highest point (85 above) so there's a
# real WARNING band between "curve maxed out" and EMERGENCY.
max_temperature = 90
# Shut down the host when safety.max_temperature is reached, after
# forcing fans to 100%. See docs/state_machine.md's EMERGENCY actions.
shutdown_on_emergency = false
# Once EMERGENCY triggers, temperature must drop this many degrees below
# max_temperature before the daemon leaves EMERGENCY. Prevents mode/fan
# speed from flapping when a sensor hovers right at the limit.
recovery_margin_c = 5

[watchdog]
enabled = true
