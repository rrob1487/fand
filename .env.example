# Template for .env. Copy to .env and fill in the values.
#
# .env holds environment-specific values (secrets, runtime overrides,
# environment flags) and is not tracked by git — see .gitignore. Do not put
# hardware or VM configuration here; that belongs in config/.
#
# Notifier configuration files reference these variables by NAME, never by
# value. See docs/configuration.md.

# Discord — see config/notification/discord.toml.example
FAND_DISCORD_TOKEN=
FAND_DISCORD_SERVER=
FAND_DISCORD_CHANNEL=

# Home Assistant — see config/notification/homeassistant.toml.example
FAND_HOMEASSISTANT_URL=
FAND_HOMEASSISTANT_TOKEN=
