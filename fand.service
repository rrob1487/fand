[Unit]
Description=Daemon For Controlling Fan Speeds
After=network-online.target 
Wants=network-online.target 

StartLimitIntervalSec=60s
StartLimitBurst=5

[Service]
Type=notify
NotifyAccess=main

ExecStart=/usr/bin/python3 /opt/fand/fand.py
ExecReload=/bin/kill -HUP $MAINPID
ExecStopPost=/usr/bin/ipmitool raw 0x30 0x30 0x01 0x01

User=fand
Group=fand
SupplementaryGroups=qemu

Restart=on-failure
RestartSec=5s

# Let systemd kill the whole process tree cleanly on stop.
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=60s
TimeoutStartSec=60s
FinalKillSignal=SIGKILL

WatchdogSec=60

# Leading '-': a missing .env must not stop the unit. It carries only
# notification credentials, and notifications must never be able to
# prevent the daemon from cooling the machine. Absent means notifiers are
# skipped with a warning, not that fan control stops.
-EnvironmentFile=/opt/fand/.env
WorkingDirectory=/opt/fand
ReadWritePaths=/opt/fand /run/fand /run/qemu
RuntimeDirectory=fand

#Security 
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
#MemoryDenyWriteExecute=true
RestrictNamespaces=true
# AF_NETLINK is needed by glibc's getaddrinfo(): __check_pf() opens a
# netlink socket to enumerate local addresses before returning results.
# Without it, DNS lookups for notification endpoints can fail in ways that
# look intermittent.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077

StandardOutput=journal
StandardError=journal
SyslogIdentifier=fand

[Install]
WantedBy=multi-user.target
